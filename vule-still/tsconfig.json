{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "**/*.mts",
    "*.ts",
    ".next-test/dev/types/**/*.ts",
    ".next-phase7-build/types/**/*.ts",
    ".next-phase7-build/dev/types/**/*.ts",
    ".next-test/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-phase1-build",
    ".next-phase3-build",
    ".next-phase4-build",
    ".next-phase5-build",
    ".next-phase6-build"
  ]
}
